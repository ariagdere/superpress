---
import '../../styles/global.css';
export const prerender = false;
const params = Astro.url.searchParams;
const pdfUrl = params.get('url') || '';
const initialPage = Math.max(1, parseInt(params.get('page') || '1', 10) || 1);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Catalogue | Superpress</title>
  <link rel="icon" href="/favicon.svg" />
  <style>
    html, body { height: 100%; margin: 0; background: var(--g100); font-family: var(--font); }
    .pv-toolbar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 50;
      background: var(--navy); color: #fff;
      display: flex; align-items: center; gap: 14px;
      padding: 10px 16px; box-shadow: var(--sh);
    }
    .pv-back {
      background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.18);
      color: #fff; border-radius: 5px; padding: 7px 12px; font: 600 13px var(--font);
      cursor: pointer; text-decoration: none; flex-shrink: 0;
    }
    .pv-back:hover { background: rgba(255,255,255,.18); }
    .pv-title { font-family: var(--cond); font-size: 15px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; min-width: 0; display: none; }
    .pv-nav, .pv-zoom { display: flex; align-items: center; gap: 6px; margin-left: auto; }
    .pv-toolbar button:not(.pv-back) {
      width: 30px; height: 30px; border-radius: 5px; border: 1px solid rgba(255,255,255,.18);
      background: rgba(255,255,255,.08); color: #fff; font-size: 16px; line-height: 1; cursor: pointer;
    }
    .pv-toolbar button:not(.pv-back):hover { background: rgba(255,255,255,.18); }
    .pv-toolbar button:disabled { opacity: .35; cursor: default; }
    .pv-toolbar button:disabled:hover { background: rgba(255,255,255,.08); }
    #pvPageInput {
      width: 44px; text-align: center; border-radius: 5px; border: 1px solid rgba(255,255,255,.18);
      background: rgba(255,255,255,.08); color: #fff; font: 600 13px var(--font); padding: 6px 2px;
    }
    .pv-of { font-size: 13px; color: rgba(255,255,255,.65); white-space: nowrap; }
    .pv-download {
      background: var(--accent); color: var(--navy); border-radius: 5px; padding: 7px 14px;
      font: 700 13px var(--font); text-decoration: none; flex-shrink: 0;
    }
    .pv-download:hover { background: var(--accent-l); }
    #pvStatus { color: var(--g400); font-size: 14px; margin: 60px auto; text-align: center; padding-top: 58px; }
    #pvStatus.error { color: #B03A2E; max-width: 420px; line-height: 1.6; }
    #pvPages { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 20px 12px 64px; padding-top: calc(20px + 58px); }
    .pv-page {
      position: relative; width: 100%; max-width: 900px; background: #fff;
      border-radius: 4px; box-shadow: var(--sh-lg); overflow: hidden;
    }
    .pv-page canvas { display: block; width: 100%; height: 100%; }
    .pv-page-label {
      position: absolute; bottom: 8px; right: 10px; background: rgba(26,46,74,.75); color: #fff;
      font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 3px; pointer-events: none;
    }
    @media (max-width: 640px) {
      .pv-toolbar { padding: 8px 10px; gap: 8px; }
      .pv-download { padding: 7px 10px; font-size: 12px; }
    }
    @media (min-width: 860px) { .pv-title { display: block; } }
  </style>
</head>
<body>
  <div class="pv-toolbar">
    <a href="#" class="pv-back" id="pvBack">← Back</a>
    <span class="pv-title">Superpress Catalogue</span>
    <div class="pv-nav">
      <button id="pvPrev" aria-label="Previous page" disabled>‹</button>
      <input type="number" id="pvPageInput" min="1" value={initialPage} disabled />
      <span class="pv-of">/ <span id="pvPageCount">–</span></span>
      <button id="pvNext" aria-label="Next page" disabled>›</button>
    </div>
    <div class="pv-zoom">
      <button id="pvZoomOut" aria-label="Zoom out" disabled>−</button>
      <button id="pvZoomIn" aria-label="Zoom in" disabled>+</button>
    </div>
    {pdfUrl && <a id="pvDownload" href={pdfUrl} download class="pv-download">Download</a>}
  </div>
  <div id="pvStatus">Loading…</div>
  <div id="pvPages"></div>

  <script type="module" define:vars={{ pdfUrl, initialPage }}>
    const PDFJS_VERSION = '4.0.379';
    const backLink = document.getElementById('pvBack');
    backLink.addEventListener('click', (e) => {
      e.preventDefault();
      if (window.history.length > 1) window.history.back();
      else window.location.href = '/en/';
    });

    const toolbarEl = document.querySelector('.pv-toolbar');
    function applyToolbarOffset() {
      const h = toolbarEl.getBoundingClientRect().height;
      document.getElementById('pvStatus').style.paddingTop = `${h + 20}px`;
      document.getElementById('pvPages').style.paddingTop = `${h + 20}px`;
    }
    applyToolbarOffset();
    window.addEventListener('resize', applyToolbarOffset);

    // Tüm sayfalar için TEK, sabit bir kaynaktan (pencere boyutu) hesaplanan ölçek —
    // her sayfanın kendi wrapper'ından clientWidth okumak (önceki yaklaşım) sayfa
    // sayfa küçük layout farklarına bağlı tutarsız zoom'a yol açıyordu.
    function computeFitScale(naturalViewport, zoom) {
      const toolbarH = toolbarEl.getBoundingClientRect().height;
      const availableWidth = Math.min(window.innerWidth - 24, 900);
      const availableHeight = window.innerHeight - toolbarH - 40;
      const widthScale = availableWidth / naturalViewport.width;
      const heightScale = availableHeight / naturalViewport.height;
      return Math.min(widthScale, heightScale) * zoom;
    }

    const statusEl = document.getElementById('pvStatus');
    const pagesEl = document.getElementById('pvPages');

    if (!pdfUrl) {
      statusEl.textContent = 'No catalogue was specified to display.';
      statusEl.classList.add('error');
    } else {
      const prevBtn = document.getElementById('pvPrev');
      const nextBtn = document.getElementById('pvNext');
      const zoomInBtn = document.getElementById('pvZoomIn');
      const zoomOutBtn = document.getElementById('pvZoomOut');
      const pageInput = document.getElementById('pvPageInput');
      const pageCountEl = document.getElementById('pvPageCount');

      let pdfDoc = null;
      let zoomFactor = 1;
      let currentDisplayedPage = initialPage;
      const pageWrappers = new Map();
      const visibleRatios = new Map();

      function setControlsEnabled(enabled) {
        [prevBtn, nextBtn, zoomInBtn, zoomOutBtn, pageInput].forEach((el) => { el.disabled = !enabled; });
      }

      function updateNavButtons() {
        prevBtn.disabled = currentDisplayedPage <= 1;
        nextBtn.disabled = currentDisplayedPage >= pdfDoc.numPages;
        pageInput.value = currentDisplayedPage;
      }

      async function renderPage(pageNum) {
        const entry = pageWrappers.get(pageNum);
        if (!entry || entry.rendered || entry.rendering) return;
        entry.rendering = true;
        try {
          const page = await pdfDoc.getPage(pageNum);
          const naturalViewport = page.getViewport({ scale: 1 });
          const fitScale = computeFitScale(naturalViewport, zoomFactor);
          const viewport = page.getViewport({ scale: fitScale });

          const outputScale = window.devicePixelRatio || 1;
          const canvas = entry.canvas;
          canvas.width = Math.floor(viewport.width * outputScale);
          canvas.height = Math.floor(viewport.height * outputScale);
          entry.wrapper.style.aspectRatio = `${viewport.width} / ${viewport.height}`;

          const ctx = canvas.getContext('2d');
          await page.render({
            canvasContext: ctx,
            viewport,
            transform: outputScale !== 1 ? [outputScale, 0, 0, outputScale, 0, 0] : null,
          }).promise;
          entry.rendered = true;
        } catch (e) {
          console.error('Sayfa render hatası', pageNum, e);
        } finally {
          entry.rendering = false;
        }
      }

      function rerenderAllVisible() {
        pageWrappers.forEach((entry, num) => {
          entry.rendered = false;
          if (visibleRatios.has(num)) renderPage(num);
        });
      }

      function scrollToPage(num) {
        num = Math.min(Math.max(1, num), pdfDoc.numPages);
        const entry = pageWrappers.get(num);
        if (entry) entry.wrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          const num = Number(entry.target.dataset.pageNum);
          if (entry.isIntersecting) {
            visibleRatios.set(num, entry.intersectionRatio);
            renderPage(num);
          } else {
            visibleRatios.delete(num);
          }
        }
        if (visibleRatios.size > 0) {
          let best = null, bestRatio = -1;
          visibleRatios.forEach((ratio, num) => { if (ratio > bestRatio) { bestRatio = ratio; best = num; } });
          if (best !== null && best !== currentDisplayedPage) {
            currentDisplayedPage = best;
            updateNavButtons();
          }
        }
      }, { rootMargin: '600px 0px', threshold: [0, 0.25, 0.5, 0.75, 1] });

      prevBtn.addEventListener('click', () => scrollToPage(currentDisplayedPage - 1));
      nextBtn.addEventListener('click', () => scrollToPage(currentDisplayedPage + 1));
      pageInput.addEventListener('change', () => {
        const n = parseInt(pageInput.value, 10);
        if (!isNaN(n)) scrollToPage(n);
      });
      zoomInBtn.addEventListener('click', () => { zoomFactor = Math.min(3, zoomFactor + 0.2); rerenderAllVisible(); });
      zoomOutBtn.addEventListener('click', () => { zoomFactor = Math.max(0.5, zoomFactor - 0.2); rerenderAllVisible(); });
      document.addEventListener('keydown', (e) => {
        if (e.target === pageInput) return;
        if (e.key === 'ArrowLeft') scrollToPage(currentDisplayedPage - 1);
        if (e.key === 'ArrowRight') scrollToPage(currentDisplayedPage + 1);
      });
      let resizeT;
      window.addEventListener('resize', () => {
        clearTimeout(resizeT);
        resizeT = setTimeout(rerenderAllVisible, 250);
      });

      const proxiedUrl = `/api/pdf-proxy?url=${encodeURIComponent(pdfUrl)}`;

      import(`https://unpkg.com/pdfjs-dist@${PDFJS_VERSION}/build/pdf.min.mjs`)
        .then((pdfjsLib) => {
          pdfjsLib.GlobalWorkerOptions.workerSrc = `https://unpkg.com/pdfjs-dist@${PDFJS_VERSION}/build/pdf.worker.min.mjs`;
          return pdfjsLib.getDocument({
            url: proxiedUrl,
            cMapUrl: `https://unpkg.com/pdfjs-dist@${PDFJS_VERSION}/cmaps/`,
            cMapPacked: true,
            standardFontDataUrl: `https://unpkg.com/pdfjs-dist@${PDFJS_VERSION}/standard_fonts/`,
          }).promise;
        })
        .then(async (doc) => {
          pdfDoc = doc;
          pageCountEl.textContent = String(doc.numPages);
          pageInput.max = String(doc.numPages);

          const firstPage = await doc.getPage(1);
          const naturalViewport = firstPage.getViewport({ scale: 1 });
          const ratio = `${naturalViewport.width} / ${naturalViewport.height}`;

          for (let i = 1; i <= doc.numPages; i++) {
            const wrapper = document.createElement('div');
            wrapper.className = 'pv-page';
            wrapper.dataset.pageNum = String(i);
            wrapper.style.aspectRatio = ratio;
            const canvas = document.createElement('canvas');
            wrapper.appendChild(canvas);
            const label = document.createElement('span');
            label.className = 'pv-page-label';
            label.textContent = `${i} / ${doc.numPages}`;
            wrapper.appendChild(label);
            pagesEl.appendChild(wrapper);
            pageWrappers.set(i, { wrapper, canvas, rendered: false, rendering: false });
            observer.observe(wrapper);
          }

          statusEl.style.display = 'none';
          setControlsEnabled(true);
          updateNavButtons();

          requestAnimationFrame(() => {
            const target = pageWrappers.get(initialPage);
            if (target) target.wrapper.scrollIntoView({ block: 'start' });
          });
        })
        .catch((err) => {
          console.error(err);
          statusEl.textContent = 'There was a problem loading the catalogue. You can download it using the link below.';
          statusEl.classList.add('error');
        });
    }
  </script>
</body>
</html>
