---
import '../../styles/global.css';
export const prerender = false;
const params = Astro.url.searchParams;
const pdfUrl = params.get('url') || '';
const initialPage = Math.max(1, parseInt(params.get('page') || '1', 10) || 1);
const proxiedUrl = pdfUrl ? `${Astro.url.origin}/api/pdf-proxy?url=${encodeURIComponent(pdfUrl)}` : '';
const viewerSrc = proxiedUrl ? `/pdfjs/web/viewer.html?file=${encodeURIComponent(proxiedUrl)}#page=${initialPage}` : '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Catalogue | Superpress</title>
  <link rel="icon" href="/favicon.svg" />
  <style>
    html, body { height: 100%; margin: 0; font-family: var(--font); }
    .pv-bar {
      background: var(--navy); color: #fff; padding: 10px 16px;
      display: flex; align-items: center; gap: 10px; box-shadow: var(--sh);
    }
    .pv-bar a {
      background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.18);
      color: #fff; border-radius: 5px; padding: 7px 12px; font: 600 13px var(--font);
      text-decoration: none;
    }
    .pv-bar a:hover { background: rgba(255,255,255,.18); }
    .pv-bar span { font-family: var(--cond); font-size: 15px; font-weight: 700; }
    iframe { width: 100%; height: calc(100vh - 50px); border: none; display: block; }
    .pv-empty { padding: 80px 20px; text-align: center; color: var(--g400); }
  </style>
</head>
<body>
  <div class="pv-bar">
    <a href="#" id="pvBack">← Back</a>
    <span>Superpress Catalogue</span>
  </div>
  {viewerSrc ? (
    <iframe src={viewerSrc} title="Katalog"></iframe>
  ) : (
    <p class="pv-empty">No catalogue was specified to display.</p>
  )}
  <script>
    document.getElementById('pvBack').addEventListener('click', (e) => {
      e.preventDefault();
      if (window.history.length > 1) window.history.back();
      else window.location.href = '/en/';
    });
  </script>
</body>
</html>
