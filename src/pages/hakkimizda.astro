---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getPageSection } from '../lib/queries.js';
import { env } from 'cloudflare:workers';
const lang = 'tr';
const anaMetin = await getPageSection(env.DB, 'hakkimizda', 'ana_metin', lang);
---
<Layout title="Hakkımızda — Superpress" lang={lang}>
  <div class="desktop-only">
    <div class="bc"><div class="bc-in"><a href="/">Ana Sayfa</a><span>›</span><span class="cur">Hakkımızda</span></div></div>
  </div>
  <div class="mobile-only">
    <div class="m-bc"><a href="/">Ana Sayfa</a><span>›</span><span style="color:var(--g800)">Hakkımızda</span></div>
  </div>
  <div class="sec"><div class="sec-in" style="max-width:820px">
    <h1 style="font-family:var(--cond);text-transform:uppercase;font-size:28px;color:var(--navy);margin-bottom:20px">Hakkımızda</h1>
    <div class="ana-metin">
      <Fragment set:html={anaMetin} />
    </div>
  </div></div>
<style>
  :global(.ana-metin p) { font-size: 14.5px; color: var(--g600); line-height: 1.9; margin-bottom: 18px; }
  :global(.ana-metin p:last-child) { margin-bottom: 0; }
</style>
</Layout>
